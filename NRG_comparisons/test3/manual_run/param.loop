#!/usr/bin/env looper
# PILOT ONLY, NOT CONVERGED. Edit numerical settings before preparing a fresh copy.
#PRELUDE: $Nz = 8;
#AUTOLOOP: true
@ $i=1; $i<=$Nz; $i++
!($z=$i/$Nz)
[param]
Nz=$Nz
model=SIAM
variant=MAGFIELD
symtype=SPU1
band=flat
bandrescale=100
bcsgap=0.01
U=2
Gamma=0.4
delta=0.5
Lambda=2
z=$z
Ninit=0
Nmax=42
keep=2000
keepmin=400
keepenergy=14
keepall=
lastall=true
discretization=Z
tri=old
options=SCHUR
diagratio=1
diag_mode=serial
diagth=1
strategy=kept
ops=n_d n_d_ud SZd SZ2d
finite=true
T=1e-5
dm=false
fdm=false
broaden=false
savebins=false
calc0=true
h5raw=true
h5all=false
h5last=true
h5ops=true
h5vectors=false
h5U=false
removefiles=true
silent=true
[extra]
B=0.03
